# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Model used for extraction and rubric judging
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT_S=90
ANTHROPIC_MAX_RETRIES=2

# Optional: make the app private. Users enter this token once in the UI.
ACCESS_TOKEN=

# Abuse and cost protection (per client IP)
RATE_LIMIT_SCORE=10 per hour;30 per day
RATE_LIMIT_EXTRACT=20 per hour;60 per day
# memory:// is per worker. Use Redis for exact limits across workers or instances.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_ENABLED=true

# Input caps (bound token cost)
MAX_UPLOAD_MB=5
MAX_RESUME_CHARS=30000
MAX_JD_CHARS=20000

# Server
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
